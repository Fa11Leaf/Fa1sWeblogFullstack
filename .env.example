# 环境变量模板。用法：
#
#     copy .env.example .env
#
# .env 已被 .gitignore 忽略，绝不入库。
#
# ── 两种数据库方案 ──────────────────────────────────────
# 方案一（当前采用）：本机已安装的 MySQL 8.0。
#     start.cmd 先探测 3306，发现 mysqld 就直接用它，不会碰 Docker。
#     需要你自己填 MYSQL_USERNAME / MYSQL_PASSWORD。
# 方案二（备用）：由 Docker 容器提供 MySQL，适合本机没装 MySQL 的机器。
#     只需填 MYSQL_ROOT_PASSWORD，其余保持默认。

# ── MySQL（方案一：本机 MySQL）──────────────────────────
# 连接账号。用 root 最省事，但应用将拥有整个实例的权限：
# 这个凭据一旦泄露，对方可以操作本机所有库（包括 sakila、world 与全部用户）。
# 想收紧的话，为项目单独建一个只授权 weblog 库的账号，改动只在 .env 一行。
MYSQL_USERNAME=root
# 本机 MySQL 的口令。留空会导致启动失败 —— 数据库凭据没有默认值可回退，
# 这是刻意的：宁可立刻报错，也不要拿一个猜出来的值去连库。
MYSQL_PASSWORD=

# ── MySQL（方案二：Docker 容器，仅方案二需要）──────────
# 只在用 docker compose 起 MySQL 时才填
MYSQL_ROOT_PASSWORD=

# ── 内部服务令牌 ───────────────────────────────────────
# Spring Boot 与 Python 能力服务共享，通过 X-Internal-Token 头传递
PY_INTERNAL_TOKEN=dev-internal-token

# ── 写作后台：登录口令 ────────────────────────────────────────────────
# users 表为空时，后端用这个口令创建第一个账号。
# 密码留空的后端行为：生成一个一次性随机口令并打在启动日志里（仅首次启动出现一次）。
# 登录后随时可在「设置」页改掉，改完所有已签发的令牌立即失效。
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Fa11Leaf
ADMIN_PASSWORD=

# ── 发布目标：公开站点所在的仓库 ──────────────────────────────────────
# 点「发布」时，后端调 GitHub Git Data API 提交到这里：一次发布 = 一个 commit
#（Markdown 一篇文章 + 它引用到的全部图片，一起组装成同一次提交）。
GITHUB_OWNER=Fa11Leaf
GITHUB_REPO=Fa11Leaf.github.io
GITHUB_BRANCH=main
GITHUB_POSTS_PATH=content/posts
GITHUB_IMAGES_PATH=public/images
GITHUB_AUTHOR_NAME=Fa11Leaf
# 提交者邮箱。留空会退回到一个 noreply 占位地址，GitHub 不接受空邮箱。
GITHUB_AUTHOR_EMAIL=

# Personal Access Token。**这是本项目最敏感的一项**：拿到它就能写你的仓库。
#   classic：https://github.com/settings/tokens → Generate new token (classic) → 勾 repo
#   fine-grained：目标仓库 → Contents 设为 Read and write
# 留空不影响写作、预览、传图，只是「发布」按钮会明确报「未配置 GITHUB_TOKEN」。
# .env 已被 .gitignore 忽略 —— 千万不要把这个文件提交上去。
GITHUB_TOKEN=

# ── 图片在本机的落脚点 ────────────────────────────────────────────────
# 发布时要从这里读文件、算 blob，所以不能放系统临时目录（重启就没了）。
MEDIA_DIR=D:\Fa11Leaf\Work\weblog-fullstack\data\media
# 超过这个宽度的图片会被等比缩到该宽度以内，避免把手机原图直接发到线上
MEDIA_MAX_WIDTH=1600
